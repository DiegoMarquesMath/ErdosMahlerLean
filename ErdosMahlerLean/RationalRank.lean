import ErdosMahlerLean.Transfer
import Mathlib.NumberTheory.Padics.PadicVal.Basic
import Mathlib.LinearAlgebra.AffineSpace.FiniteDimensional
import Mathlib.LinearAlgebra.Dimension.DivisionRing
import Mathlib.RingTheory.Localization.Module
import Mathlib.LinearAlgebra.FreeModule.PID

/-! Prime valuations and the exact affine multiplicative rank of positive rationals. -/

namespace ErdosMahlerLean
noncomputable section
open Module
set_option maxHeartbeats 1000000

/-- All prime valuations, regarded as rational coordinates. -/
def rationalValuation (x : ℚ) : Nat.Primes → ℚ :=
  fun p => (padicValRat p x : ℚ)

theorem rationalValuation_one : rationalValuation 1 = 0 := by
  ext p
  simp [rationalValuation]

theorem rationalValuation_mul {x y : ℚ} (hx : x ≠ 0) (hy : y ≠ 0) :
    rationalValuation (x * y) = rationalValuation x + rationalValuation y := by
  ext p
  letI : Fact (Nat.Prime p.val) := ⟨p.property⟩
  simp [rationalValuation, padicValRat.mul hx hy]

theorem rationalValuation_div {x y : ℚ} (hx : x ≠ 0) (hy : y ≠ 0) :
    rationalValuation (x / y) = rationalValuation x - rationalValuation y := by
  ext p
  letI : Fact (Nat.Prime p.val) := ⟨p.property⟩
  simp [rationalValuation, padicValRat.div hx hy]

theorem rationalValuation_eq_zero_iff {x : ℚ} (hx : 0 < x) :
    rationalValuation x = 0 ↔ x = 1 := by
  constructor
  · intro h
    have hnum : x.num.natAbs = x.den := by
      apply Nat.eq_of_factorization_eq (by simpa using hx.ne') x.den_nz
      intro p
      by_cases hp : p.Prime
      · have hv := congrFun h (⟨p, hp⟩ : Nat.Primes)
        have he : padicValRat p x = 0 := by
          change (padicValRat p x : ℚ) = 0 at hv
          exact_mod_cast hv
        simp only [padicValRat, padicValInt] at he
        rw [Nat.factorization_def _ hp, Nat.factorization_def _ hp]
        omega
      · simp [Nat.factorization_eq_zero_of_not_prime _ hp]
    have hxnum : 0 ≤ x.num := (Rat.num_nonneg.mpr hx.le)
    have hnum' : x.num = (x.den : ℤ) := by
      simpa [Int.natCast_natAbs, abs_of_nonneg hxnum] using congrArg (fun n : ℕ => (n : ℤ)) hnum
    rw [← Rat.num_divInt_den x, hnum']
    simp [Rat.divInt_eq_div, x.den_nz]
  · rintro rfl
    exact rationalValuation_one

theorem rationalValuation_injective_pos :
    Set.InjOn rationalValuation (Set.Ioi (0 : ℚ)) := by
  intro x hx y hy h
  have hz : rationalValuation (x / y) = 0 := by
    rw [rationalValuation_div (ne_of_gt hx) (ne_of_gt hy), h, sub_self]
  exact (div_eq_one_iff_eq (ne_of_gt hy)).mp
    ((rationalValuation_eq_zero_iff (div_pos hx hy)).mp hz)

/-- The integer lattice generated by ratios to a specified base point.
By injectivity of prime valuations this is the actual multiplicative ratio group. -/
def rationalRatioLattice (X : Finset ℚ) (x₀ : ℚ) : Submodule ℤ (Nat.Primes → ℚ) :=
  Submodule.span ℤ (rationalValuation '' ((fun x => x / x₀) '' (X : Set ℚ)))

/-- Rational scalar extension of the ratio lattice. -/
def rationalRatioSpace (X : Finset ℚ) (x₀ : ℚ) : Submodule ℚ (Nat.Primes → ℚ) :=
  Submodule.span ℚ (rationalValuation '' ((fun x => x / x₀) '' (X : Set ℚ)))

/-- Rank of the actual integer valuation lattice, before any scalar extension. -/
def affineMultiplicativeRankAt (X : Finset ℚ) (x₀ : ℚ) : ℕ :=
  finrank ℤ (rationalRatioLattice X x₀)

theorem rationalRatioSpace_finrank (X : Finset ℚ) (x₀ : ℚ) :
    finrank ℚ (rationalRatioSpace X x₀) = affineMultiplicativeRankAt X x₀ := by
  have h := Submodule.finrank_span_eq_finrank_of_linearIndepOn
    (K := ℚ) (rationalRatioLattice X x₀) (fun s _ hs =>
      (LinearIndependent.iff_fractionRing ℤ ℚ).mp hs)
  unfold rationalRatioLattice at h
  rw [Submodule.span_span_of_tower ℤ ℚ] at h
  exact h

/-- The ratio lattice is the integer affine direction space; in particular it
is independent of the chosen element of the set. -/
theorem rationalRatioLattice_eq_vectorSpan (X : Finset ℚ) {x₀ : ℚ}
    (hx₀ : x₀ ∈ X) (hX : ∀ x ∈ X, 0 < x) :
    rationalRatioLattice X x₀ = vectorSpan ℤ (rationalValuation '' (X : Set ℚ)) := by
  rw [vectorSpan_eq_span_vsub_set_right ℤ (Set.mem_image_of_mem rationalValuation hx₀)]
  unfold rationalRatioLattice
  congr 1
  ext v
  simp only [Set.mem_image, Finset.mem_coe]
  constructor
  · rintro ⟨y, ⟨x, hx, rfl⟩, rfl⟩
    exact ⟨rationalValuation x, ⟨x, hx, rfl⟩,
      (rationalValuation_div (hX x hx).ne' (hX x₀ hx₀).ne').symm⟩
  · rintro ⟨v, ⟨x, hx, rfl⟩, rfl⟩
    exact ⟨x / x₀, ⟨x, hx, rfl⟩,
      rationalValuation_div (hX x hx).ne' (hX x₀ hx₀).ne'⟩

theorem rationalRatioLattice_basepoint (X : Finset ℚ) {x₀ x₁ : ℚ}
    (hx₀ : x₀ ∈ X) (hx₁ : x₁ ∈ X) (hX : ∀ x ∈ X, 0 < x) :
    rationalRatioLattice X x₀ = rationalRatioLattice X x₁ := by
  rw [rationalRatioLattice_eq_vectorSpan X hx₀ hX,
    rationalRatioLattice_eq_vectorSpan X hx₁ hX]

/-- The rank of the integer affine valuation lattice. -/
def affineMultiplicativeRank (X : Finset ℚ) : ℕ :=
  finrank ℤ (vectorSpan ℤ (rationalValuation '' (X : Set ℚ)))

theorem affineMultiplicativeRank_eq_at (X : Finset ℚ) {x₀ : ℚ}
    (hx₀ : x₀ ∈ X) (hX : ∀ x ∈ X, 0 < x) :
    affineMultiplicativeRank X = affineMultiplicativeRankAt X x₀ := by
  unfold affineMultiplicativeRank affineMultiplicativeRankAt
  exact congrArg (fun S : Submodule ℤ (Nat.Primes → ℚ) => finrank ℤ S) (rationalRatioLattice_eq_vectorSpan X hx₀ hX).symm

theorem rationalRatioSpace_eq_vectorSpan (X : Finset ℚ) {x₀ : ℚ}
    (hx₀ : x₀ ∈ X) (hX : ∀ x ∈ X, 0 < x) :
    rationalRatioSpace X x₀ = vectorSpan ℚ (rationalValuation '' (X : Set ℚ)) := by
  rw [vectorSpan_eq_span_vsub_set_right ℚ (Set.mem_image_of_mem rationalValuation hx₀)]
  unfold rationalRatioSpace
  congr 1
  ext v
  simp only [Set.mem_image, Finset.mem_coe]
  constructor
  · rintro ⟨y, ⟨x, hx, rfl⟩, rfl⟩
    exact ⟨rationalValuation x, ⟨x, hx, rfl⟩,
      (rationalValuation_div (hX x hx).ne' (hX x₀ hx₀).ne').symm⟩
  · rintro ⟨v, ⟨x, hx, rfl⟩, rfl⟩
    exact ⟨x / x₀, ⟨x, hx, rfl⟩,
      rationalValuation_div (hX x hx).ne' (hX x₀ hx₀).ne'⟩

theorem affineMultiplicativeRank_eq_finrank (X : Finset ℚ) (hX : ∀ x ∈ X, 0 < x)
    (hne : X.Nonempty) :
    affineMultiplicativeRank X =
      finrank ℚ (vectorSpan ℚ (rationalValuation '' (X : Set ℚ))) := by
  obtain ⟨x₀, hx₀⟩ := hne
  rw [affineMultiplicativeRank_eq_at X hx₀ hX, ← rationalRatioSpace_finrank,
    rationalRatioSpace_eq_vectorSpan X hx₀ hX]

theorem mem_tripleProductset {X : Finset ℚ} {z : ℚ} :
    z ∈ tripleProductset X ↔
      ∃ x ∈ X, ∃ y ∈ X, ∃ w ∈ X, x * y * w = z := by
  simp only [tripleProductset, Finset.mem_image, Finset.mem_product, Prod.exists]
  constructor
  · rintro ⟨x, y, w, ⟨hx, hy, hw⟩, he⟩
    exact ⟨x, hx, y, hy, w, hw, he⟩
  · rintro ⟨x, hx, y, hy, w, hw, he⟩
    exact ⟨x, y, w, ⟨hx, hy, hw⟩, he⟩

theorem tripleProductset_pos (X : Finset ℚ) (hX : ∀ x ∈ X, 0 < x) :
    ∀ z ∈ tripleProductset X, 0 < z := by
  intro z hz
  obtain ⟨x, hx, y, hy, w, hw, rfl⟩ := mem_tripleProductset.mp hz
  exact mul_pos (mul_pos (hX x hx) (hX y hy)) (hX w hw)

theorem tripleProductset_cube_mem {X : Finset ℚ} {x : ℚ} (hx : x ∈ X) :
    x ^ 3 ∈ tripleProductset X := by
  exact mem_tripleProductset.mpr ⟨x, hx, x, hx, x, hx, by ring⟩

/-- Threefold products generate exactly the same ratio lattice, without an
index bound or a product-correspondence assumption. -/
theorem rationalRatioLattice_triple (X : Finset ℚ) {x₀ : ℚ}
    (hx₀ : x₀ ∈ X) (hX : ∀ x ∈ X, 0 < x) :
    rationalRatioLattice (tripleProductset X) (x₀ ^ 3) = rationalRatioLattice X x₀ := by
  have h₀ : x₀ ≠ 0 := (hX x₀ hx₀).ne'
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro v ⟨z, ⟨u, hu, rfl⟩, rfl⟩
    obtain ⟨x, hx, y, hy, w, hw, rfl⟩ := mem_tripleProductset.mp hu
    have he : x * y * w / x₀ ^ 3 = (x / x₀) * (y / x₀) * (w / x₀) := by ring
    change rationalValuation (x * y * w / x₀ ^ 3) ∈ rationalRatioLattice X x₀
    rw [he, rationalValuation_mul (mul_ne_zero (div_ne_zero (hX x hx).ne' h₀)
      (div_ne_zero (hX y hy).ne' h₀)) (div_ne_zero (hX w hw).ne' h₀),
      rationalValuation_mul (div_ne_zero (hX x hx).ne' h₀) (div_ne_zero (hX y hy).ne' h₀)]
    exact Submodule.add_mem _ (Submodule.add_mem _
      (Submodule.subset_span ⟨x / x₀, ⟨x, hx, rfl⟩, rfl⟩)
      (Submodule.subset_span ⟨y / x₀, ⟨y, hy, rfl⟩, rfl⟩))
      (Submodule.subset_span ⟨w / x₀, ⟨w, hw, rfl⟩, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro v ⟨z, ⟨x, hx, rfl⟩, rfl⟩
    have he : (x * x₀ * x₀) / x₀ ^ 3 = x / x₀ := by field_simp
    change rationalValuation (x / x₀) ∈ rationalRatioLattice (tripleProductset X) (x₀ ^ 3)
    rw [← he]
    exact Submodule.subset_span ⟨(x * x₀ * x₀) / x₀ ^ 3,
      ⟨x * x₀ * x₀, mem_tripleProductset.mpr ⟨x, hx, x₀, hx₀, x₀, hx₀, rfl⟩, rfl⟩, rfl⟩

theorem affineMultiplicativeRank_triple (X : Finset ℚ) (hne : X.Nonempty)
    (hX : ∀ x ∈ X, 0 < x) :
    affineMultiplicativeRank (tripleProductset X) = affineMultiplicativeRank X := by
  obtain ⟨x₀, hx₀⟩ := hne
  rw [affineMultiplicativeRank_eq_at _ (tripleProductset_cube_mem hx₀)
    (tripleProductset_pos X hX), affineMultiplicativeRank_eq_at X hx₀ hX]
  unfold affineMultiplicativeRankAt
  rw [rationalRatioLattice_triple X hx₀ hX]

theorem affineMultiplicativeRank_lt_card (X : Finset ℚ) (hne : X.Nonempty)
    (hX : ∀ x ∈ X, 0 < x) : affineMultiplicativeRank X < X.card := by
  classical
  rw [affineMultiplicativeRank_eq_finrank X hX hne]
  have hcpos := Finset.card_pos.mpr hne
  have hc : X.card = (X.card - 1) + 1 := by omega
  have h := finrank_vectorSpan_image_finset_le ℚ rationalValuation X hc
  rw [Finset.coe_image] at h
  omega

/-- Threefold additive sumset in an arbitrary rational vector space. -/
def tripleAddSet {V : Type*} [AddCommMonoid V] (E : Finset V) : Finset V := by
  classical
  exact (E ×ˢ E ×ˢ E).image (fun p => p.1 + p.2.1 + p.2.2)

theorem mem_tripleAddSet {V : Type*} [AddCommMonoid V] {E : Finset V} {v : V} :
    v ∈ tripleAddSet E ↔ ∃ x ∈ E, ∃ y ∈ E, ∃ z ∈ E, x + y + z = v := by
  classical
  simp only [tripleAddSet, Finset.mem_image, Finset.mem_product, Prod.exists]
  constructor
  · rintro ⟨x, y, z, ⟨hx, hy, hz⟩, he⟩
    exact ⟨x, hx, y, hy, z, hz, he⟩
  · rintro ⟨x, hx, y, hy, z, hz, he⟩
    exact ⟨x, y, z, ⟨hx, hy, hz⟩, he⟩

theorem tripleAddSet_image {V W : Type*} [AddCommMonoid V] [AddCommMonoid W] [DecidableEq W]
    (f : V →+ W) (E : Finset V) :
    tripleAddSet (E.image f) = (tripleAddSet E).image f := by
  classical
  ext v
  simp only [mem_tripleAddSet, Finset.mem_image]
  constructor
  · rintro ⟨_, ⟨x, hx, rfl⟩, _, ⟨y, hy, rfl⟩, _, ⟨z, hz, rfl⟩, he⟩
    exact ⟨x + y + z, ⟨x, hx, y, hy, z, hz, rfl⟩, by simpa using he⟩
  · rintro ⟨_, ⟨x, hx, y, hy, z, hz, rfl⟩, rfl⟩
    exact ⟨f x, ⟨x, hx, rfl⟩, f y, ⟨y, hy, rfl⟩, f z, ⟨z, hz, rfl⟩,
      by simp⟩

/-- Coordinatewise rational-to-real inclusion, linear over the rationals. -/
def rationalRealCoordinates (d : ℕ) : (Fin d → ℚ) →ₗ[ℚ] (Fin d → ℝ) where
  toFun v i := (v i : ℝ)
  map_add' v w := by ext i; simp
  map_smul' a v := by ext i; simp [Rat.smul_def]

theorem rationalRealCoordinates_injective (d : ℕ) :
    Function.Injective (rationalRealCoordinates d) := by
  intro v w h
  ext i
  have hi := congrFun h i
  change (v i : ℝ) = (w i : ℝ) at hi
  exact_mod_cast hi

/-- Rational spanning implies real spanning after coordinatewise inclusion.
The proof uses rational span induction and the standard coordinate vectors. -/
theorem rationalRealCoordinates_span {d : ℕ} (E : Finset (Fin d → ℚ))
    (hE : Submodule.span ℚ (E : Set (Fin d → ℚ)) = ⊤) :
    Submodule.span ℝ ((E.image (rationalRealCoordinates d) : Finset (Fin d → ℝ)) :
      Set (Fin d → ℝ)) = ⊤ := by
  classical
  let S := Submodule.span ℝ ((E.image (rationalRealCoordinates d) : Finset (Fin d → ℝ)) :
    Set (Fin d → ℝ))
  have hmap : ∀ v : Fin d → ℚ, rationalRealCoordinates d v ∈ S := by
    intro v
    have hv : v ∈ Submodule.span ℚ (E : Set (Fin d → ℚ)) := by rw [hE]; trivial
    induction hv using Submodule.span_induction with
    | mem v hv => exact Submodule.subset_span (Finset.mem_image.mpr ⟨v, hv, rfl⟩)
    | zero => simpa using S.zero_mem
    | add x y hx hy ihx ihy => simpa using S.add_mem ihx ihy
    | smul a x hx ih =>
      rw [map_smul]
      have he : a • rationalRealCoordinates d x = (a : ℝ) • rationalRealCoordinates d x := by
        ext i
        simp [Rat.smul_def]
      rw [he]
      exact S.smul_mem (a : ℝ) ih
  apply top_unique
  intro v _
  have hsum : v = ∑ i : Fin d, v i • Pi.single i (1 : ℝ) := by
    ext j
    simp [Pi.single_apply]
  rw [hsum]
  apply S.sum_mem
  intro i _
  apply S.smul_mem
  convert hmap (Pi.single i (1 : ℚ)) using 1
  ext j
  simp only [rationalRealCoordinates, LinearMap.coe_mk, AddHom.coe_mk, Pi.single_apply]
  split_ifs <;> norm_num

/-- The source-checked real Matolcsi–Ruzsa theorem transported to a full-span
finite set of rational coordinate vectors. -/
theorem matolcsi_rational_full (hMR : External.MatolcsiRuzsaThree)
    (d : ℕ) (hd : 1 ≤ d) (E : Finset (Fin d → ℚ)) (h0 : 0 ∈ E)
    (hspan : Submodule.span ℚ (E : Set (Fin d → ℚ)) = ⊤) :
    ((d + 2).choose 2 : ℝ) * ((E.card : ℝ) - 2 * (d : ℝ) / 3) ≤
      ((tripleAddSet E).card : ℝ) := by
  classical
  let f := rationalRealCoordinates d
  let G := E.image f
  have hG0 : (0 : Fin d → ℝ) ∈ G := Finset.mem_image.mpr ⟨0, h0, map_zero f⟩
  have hGspan : affineSpan ℝ (G : Set (Fin d → ℝ)) = ⊤ := by
    rw [affineSpan_eq_span_of_zero_mem (subset_affineSpan ℝ _ hG0),
      rationalRealCoordinates_span E hspan, Submodule.toAffineSubspace_top]
  have hGcard : G.card = E.card := Finset.card_image_of_injective E
    (rationalRealCoordinates_injective d)
  have htrip : (External.tripleSum G).card = (tripleAddSet E).card := by
    have hdef : External.tripleSum G = tripleAddSet G := by
      ext v
      simp [External.tripleSum, tripleAddSet]
    rw [hdef]
    calc
      (tripleAddSet G).card = ((tripleAddSet E).image f).card :=
        congrArg Finset.card (tripleAddSet_image f.toAddMonoidHom E)
      _ = _ := Finset.card_image_of_injective _ (rationalRealCoordinates_injective d)
  have h := hMR d hd G ⟨0, hG0⟩ hGspan
  rwa [hGcard, htrip] at h

/-- Elementary final simplification of the exact Matolcsi–Ruzsa constant. -/
theorem matolcsi_rank_algebra (d M P : ℕ) (hdM : d < M)
    (hMR : ((d + 2).choose 2 : ℝ) * ((M : ℝ) - 2 * (d : ℝ) / 3) ≤ (P : ℝ)) :
    (M : ℝ) * (d : ℝ) ^ 2 ≤ 6 * (P : ℝ) := by
  have hchoose : (2 : ℝ) * ((d + 2).choose 2 : ℝ) = ((d : ℝ) + 2) * ((d : ℝ) + 1) := by
    have h := Nat.add_one_mul_choose_eq (d + 1) 1
    simp only [Nat.choose_one_right] at h
    have hn : 2 * (d + 2).choose 2 = (d + 2) * (d + 1) := by
      simpa [Nat.add_assoc, Nat.mul_comm] using h.symm
    exact_mod_cast hn
  have hdM' : (d : ℝ) ≤ M := by exact_mod_cast hdM.le
  have hd : (0 : ℝ) ≤ d := Nat.cast_nonneg _
  have hM : (0 : ℝ) ≤ M := Nat.cast_nonneg _
  have hc : (0 : ℝ) ≤ ((d + 2).choose 2 : ℝ) := Nat.cast_nonneg _
  have hfirst : (M : ℝ) / 3 ≤ (M : ℝ) - 2 * (d : ℝ) / 3 := by linarith
  have hsecond : (d : ℝ) ^ 2 / 2 ≤ ((d + 2).choose 2 : ℝ) := by nlinarith
  have hprod := mul_le_mul hsecond hfirst (by positivity : (0 : ℝ) ≤ (M : ℝ) / 3) hc
  nlinarith

/-- Matolcsi–Ruzsa for any finite set in a rational vector space containing zero;
the dimension is computed internally from its actual span. -/
theorem matolcsi_rational_span {V : Type*} [AddCommGroup V] [Module ℚ V]
    (hMR : External.MatolcsiRuzsaThree) (E : Finset V) (h0 : 0 ∈ E)
    (hd : 1 ≤ finrank ℚ (Submodule.span ℚ (E : Set V))) :
    ((finrank ℚ (Submodule.span ℚ (E : Set V)) + 2).choose 2 : ℝ) *
      ((E.card : ℝ) - 2 * (finrank ℚ (Submodule.span ℚ (E : Set V)) : ℝ) / 3) ≤
      ((tripleAddSet E).card : ℝ) := by
  classical
  let S := Submodule.span ℚ (E : Set V)
  letI : FiniteDimensional ℚ S := FiniteDimensional.span_of_finite ℚ E.finite_toSet
  let e := (Module.finBasis ℚ S).equivFun
  let lift : E → S := fun x => ⟨x.val, Submodule.subset_span x.property⟩
  let ES := E.attach.image lift
  have hES : ES.image S.subtype = E := by
    ext x
    constructor
    · intro hx
      obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hu
      exact y.property
    · intro hx
      exact Finset.mem_image.mpr ⟨lift ⟨x, hx⟩,
        Finset.mem_image.mpr ⟨⟨x, hx⟩, Finset.mem_attach _ _, rfl⟩, rfl⟩
  have hES0 : (0 : S) ∈ ES := Finset.mem_image.mpr
    ⟨⟨0, h0⟩, Finset.mem_attach _ _, Subtype.ext rfl⟩
  have hESspan : Submodule.span ℚ (ES : Set S) = ⊤ := by
    apply (Submodule.span_val_image_eq_iff S (ES : Set S)).mp
    rw [← Finset.coe_image]
    change Submodule.span ℚ ((ES.image S.subtype : Finset V) : Set V) = S
    rw [hES]
  let F := ES.image e
  have hFspan : Submodule.span ℚ (F : Set (Fin (finrank ℚ S) → ℚ)) = ⊤ := by
    rw [Finset.coe_image]
    change Submodule.span ℚ (e.toLinearMap '' (ES : Set S)) = ⊤
    rw [← Submodule.map_span, hESspan, Submodule.map_top]
    exact LinearMap.range_eq_top.mpr e.surjective
  have hF0 : (0 : Fin (finrank ℚ S) → ℚ) ∈ F :=
    Finset.mem_image.mpr ⟨0, hES0, map_zero e⟩
  have hcard : F.card = E.card := by
    calc
      F.card = ES.card := Finset.card_image_of_injective _ e.injective
      _ = (ES.image S.subtype).card :=
        (Finset.card_image_of_injective ES (show Function.Injective S.subtype from
          Subtype.coe_injective)).symm
      _ = E.card := congrArg Finset.card hES
  have htriple : (tripleAddSet F).card = (tripleAddSet E).card := by
    have hleft : (tripleAddSet F).card = (tripleAddSet ES).card := by
      calc
        _ = ((tripleAddSet ES).image e).card :=
          congrArg Finset.card (tripleAddSet_image e.toAddMonoidHom ES)
        _ = _ := Finset.card_image_of_injective _ e.injective
    have hright : (tripleAddSet E).card = (tripleAddSet ES).card := by
      calc
        _ = (tripleAddSet (ES.image S.subtype)).card := by rw [hES]
        _ = ((tripleAddSet ES).image S.subtype).card :=
          congrArg Finset.card (tripleAddSet_image S.subtype.toAddMonoidHom ES)
        _ = _ := Finset.card_image_of_injective _ (show Function.Injective S.subtype from
          Subtype.coe_injective)
    exact hleft.trans hright.symm
  have h := matolcsi_rational_full hMR (finrank ℚ S) hd F hF0 hFspan
  rwa [hcard, htriple] at h

/-- The finite set of normalized valuation vectors. -/
def rationalRatioVectors (X : Finset ℚ) (x₀ : ℚ) : Finset (Nat.Primes → ℚ) := by
  classical
  exact X.image (fun x => rationalValuation (x / x₀))

theorem rationalRatioVectors_span (X : Finset ℚ) (x₀ : ℚ) :
    Submodule.span ℚ (rationalRatioVectors X x₀ : Set (Nat.Primes → ℚ)) =
      rationalRatioSpace X x₀ := by
  classical
  simp only [rationalRatioVectors, Finset.coe_image, rationalRatioSpace, Set.image_image]

theorem rationalRatioVectors_card (X : Finset ℚ) {x₀ : ℚ} (h₀ : 0 < x₀)
    (hX : ∀ x ∈ X, 0 < x) : (rationalRatioVectors X x₀).card = X.card := by
  classical
  apply Finset.card_image_iff.mpr
  intro x hx y hy he
  exact (div_left_inj' h₀.ne').mp (rationalValuation_injective_pos
    (div_pos (hX x hx) h₀) (div_pos (hX y hy) h₀) he)

theorem rationalRatioVectors_zero {X : Finset ℚ} {x₀ : ℚ} (hx₀ : x₀ ∈ X)
    (h₀ : x₀ ≠ 0) : 0 ∈ rationalRatioVectors X x₀ := by
  classical
  exact Finset.mem_image.mpr ⟨x₀, hx₀, by rw [div_self h₀, rationalValuation_one]⟩

theorem rationalValuation_triple_ratio {x y z x₀ : ℚ}
    (hx : x ≠ 0) (hy : y ≠ 0) (hz : z ≠ 0) (h₀ : x₀ ≠ 0) :
    rationalValuation (x * y * z / x₀ ^ 3) =
      rationalValuation (x / x₀) + rationalValuation (y / x₀) +
        rationalValuation (z / x₀) := by
  rw [show x * y * z / x₀ ^ 3 = x / x₀ * (y / x₀) * (z / x₀) by ring,
    rationalValuation_mul (mul_ne_zero (div_ne_zero hx h₀) (div_ne_zero hy h₀))
      (div_ne_zero hz h₀), rationalValuation_mul (div_ne_zero hx h₀) (div_ne_zero hy h₀)]

theorem rationalRatioVectors_triple (X : Finset ℚ) {x₀ : ℚ} (h₀ : x₀ ≠ 0)
    (hX : ∀ x ∈ X, 0 < x) :
    tripleAddSet (rationalRatioVectors X x₀) =
      rationalRatioVectors (tripleProductset X) (x₀ ^ 3) := by
  classical
  ext v
  simp only [mem_tripleAddSet, rationalRatioVectors, Finset.mem_image]
  constructor
  · rintro ⟨_, ⟨x, hx, rfl⟩, _, ⟨y, hy, rfl⟩, _, ⟨z, hz, rfl⟩, he⟩
    exact ⟨x * y * z, mem_tripleProductset.mpr ⟨x, hx, y, hy, z, hz, rfl⟩,
      (rationalValuation_triple_ratio (hX x hx).ne' (hX y hy).ne' (hX z hz).ne' h₀).trans he⟩
  · rintro ⟨_, ht, rfl⟩
    obtain ⟨x, hx, y, hy, z, hz, rfl⟩ := mem_tripleProductset.mp ht
    exact ⟨_, ⟨x, hx, rfl⟩, _, ⟨y, hy, rfl⟩, _, ⟨z, hz, rfl⟩,
      (rationalValuation_triple_ratio (hX x hx).ne' (hX y hy).ne' (hX z hz).ne' h₀).symm⟩

/-- Frozen Lemma 3.6, with a stronger domain: all finite nonempty sets of
positive rationals. The rank is that of the integer ratio lattice, and the
sole mathematical external hypothesis is the published Matolcsi–Ruzsa input. -/
theorem multiplicative_rank_bound (hMR : External.MatolcsiRuzsaThree)
    (X : Finset ℚ) (hne : X.Nonempty) (hX : ∀ x ∈ X, 0 < x)
    (hd : 1 ≤ affineMultiplicativeRank X) :
    affineMultiplicativeRank (tripleProductset X) = affineMultiplicativeRank X ∧
      (X.card : ℝ) * (affineMultiplicativeRank X : ℝ) ^ 2 ≤
        6 * ((tripleProductset X).card : ℝ) := by
  refine ⟨affineMultiplicativeRank_triple X hne hX, ?_⟩
  obtain ⟨x₀, hx₀⟩ := hne
  have h₀ := hX x₀ hx₀
  let E := rationalRatioVectors X x₀
  have hdim : finrank ℚ (Submodule.span ℚ (E : Set (Nat.Primes → ℚ))) =
      affineMultiplicativeRank X := by
    rw [rationalRatioVectors_span, rationalRatioSpace_finrank,
      ← affineMultiplicativeRank_eq_at X hx₀ hX]
  have h0 : 0 ∈ E := rationalRatioVectors_zero hx₀ h₀.ne'
  have h := matolcsi_rational_span hMR E h0 (by rwa [hdim])
  have hcard : E.card = X.card := rationalRatioVectors_card X h₀ hX
  have htriple : (tripleAddSet E).card = (tripleProductset X).card := by
    rw [rationalRatioVectors_triple X h₀.ne' hX]
    exact rationalRatioVectors_card _ (pow_pos h₀ _) (tripleProductset_pos X hX)
  rw [hdim, hcard, htriple] at h
  exact matolcsi_rank_algebra _ _ _ (affineMultiplicativeRank_lt_card X ⟨x₀, hx₀⟩ hX) h

theorem rationalValuation_zpow {x : ℚ} (hx : x ≠ 0) (n : ℤ) :
    rationalValuation (x ^ n) = n • rationalValuation x := by
  ext p
  letI : Fact (Nat.Prime p.val) := ⟨p.property⟩
  simp [rationalValuation, padicValRat.zpow, zsmul_eq_mul]

/-- Every element of the integer ratio lattice is realized by a positive
rational number. This rules out introducing an enlarged abstract lattice. -/
theorem rationalRatioLattice_realized (X : Finset ℚ) {x₀ : ℚ}
    (h₀ : 0 < x₀) (hX : ∀ x ∈ X, 0 < x)
    {v : Nat.Primes → ℚ} (hv : v ∈ rationalRatioLattice X x₀) :
    ∃ g : ℚ, 0 < g ∧ rationalValuation g = v := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨y, ⟨x, hx, rfl⟩, rfl⟩ := hv
    exact ⟨x / x₀, div_pos (hX x hx) h₀, rfl⟩
  | zero => exact ⟨1, by norm_num, rationalValuation_one⟩
  | add x y hx hy ihx ihy =>
    obtain ⟨a, ha, rfl⟩ := ihx
    obtain ⟨b, hb, rfl⟩ := ihy
    exact ⟨a * b, mul_pos ha hb, rationalValuation_mul ha.ne' hb.ne'⟩
  | smul n v hv ih =>
    obtain ⟨g, hg, rfl⟩ := ih
    exact ⟨g ^ n, zpow_pos hg _, rationalValuation_zpow hg.ne' n⟩

instance rationalRatioLattice_finite (X : Finset ℚ) (x₀ : ℚ) :
    Module.Finite ℤ (rationalRatioLattice X x₀) :=
  Module.Finite.iff_fg.mpr (Submodule.fg_span
    ((X.finite_toSet.image (fun x => x / x₀)).image rationalValuation))

theorem rationalValuation_prod {ι : Type*} (S : Finset ι) (f : ι → ℚ)
    (hf : ∀ i ∈ S, f i ≠ 0) :
    rationalValuation (∏ i ∈ S, f i) = ∑ i ∈ S, rationalValuation (f i) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp [rationalValuation_one]
  | @insert i S hi ih =>
    rw [Finset.prod_insert hi, Finset.sum_insert hi,
      rationalValuation_mul (hf i (Finset.mem_insert_self _ _))
        (Finset.prod_ne_zero_iff.mpr (fun j hj => hf j (Finset.mem_insert_of_mem hj))),
      ih (fun j hj => hf j (Finset.mem_insert_of_mem hj))]

/-- Exact membership in the ratio group: a positive rational has valuation in
the lattice if and only if it is an integral product of the original ratios.
This is the group-to-lattice reconciliation needed for the manuscript's rank. -/
theorem rationalRatioLattice_iff_integral_product (X : Finset ℚ) {x₀ g : ℚ}
    (h₀ : 0 < x₀) (hg : 0 < g) (hX : ∀ x ∈ X, 0 < x) :
    rationalValuation g ∈ rationalRatioLattice X x₀ ↔
      ∃ c : ℚ → ℤ, g = ∏ x ∈ X, (x / x₀) ^ c x := by
  classical
  have hprod (c : ℚ → ℤ) :
      rationalValuation (∏ x ∈ X, (x / x₀) ^ c x) =
        ∑ x ∈ X, c x • rationalValuation (x / x₀) := by
    rw [rationalValuation_prod X _ (fun x hx => zpow_ne_zero _
      (div_ne_zero (hX x hx).ne' h₀.ne'))]
    apply Finset.sum_congr rfl
    intro x hx
    exact rationalValuation_zpow (div_ne_zero (hX x hx).ne' h₀.ne') (c x)
  unfold rationalRatioLattice
  rw [Set.image_image, Submodule.mem_span_image_finset_iff_exists_fun']
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, rationalValuation_injective_pos hg
      (Finset.prod_pos (fun x hx => zpow_pos (div_pos (hX x hx) h₀) _)) ?_⟩
    rw [hprod]
    exact hc.symm
  · rintro ⟨c, rfl⟩
    exact ⟨c, (hprod c).symm⟩

end
